# Token del Bot de Telegram (Obtenido de @BotFather)
BOT_TOKEN=tu_token_aqui

# URL de la Base de Datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/taximotos?schema=public"

# IDs de administradores (separados por coma)
ADMIN_IDS=12345678,87654321

# ID del grupo de conductores (donde el bot enviará los viajes disponibles)
# TIP: Puedes obtenerlo añadiendo al bot @MissRose_bot al grupo y escribiendo /id
DRIVER_GROUP_ID=-1001234567890

# Entorno
NODE_ENV=development
PORT=3000
